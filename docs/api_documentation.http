# Cinelog API
#
# Auth is cookie-based (httpOnly `auth_token`), not Bearer.
# Send Login (or Signup) first. httpYac stores the cookie and sends it on later requests.
# Select the `dev` environment, then fill docs/http-client.private.env.json with credentials.
#
# @host = {{host}}

### Signup
# Username: 3-10 chars, letters/numbers/underscore
# Password: 6-20 chars, upper, lower, number, and one of @ # & ! _
POST /api/auth/signup
Content-Type: application/json

{
  "username": "{{username}}",
  "email": "{{email}}",
  "password": "{{password}}",
  "displayName": "{{displayName}}"
}

### Login
# @name login
POST /api/auth/login
Content-Type: application/json

{
  "username": "{{username}}",
  "password": "{{password}}"
}

### Current user
# Requires cookie from Login or Signup
GET /api/auth/me

### Logout
POST /api/auth/logout

### Search movies (anonymous)
# Optional cookie: logged-in users get is_present_in_watchlist and watch_status
# Query: query (required), year (maps to TMDB primary_release_year), language
#   (optional ISO 639-1 e.g. ja — post-filtered on original_language), page (default 1)
# Response: { results, page, total_pages, total_results }
# @no-cookie-jar
GET /api/search/movie?query={{query}}&year=2024&language=ja&page=1

### Search movies (with session)
GET /api/search/movie?query={{query}}&year=2024&language=ja&page=1

### Search series
# Query: query (required), year (maps to TMDB year), language (optional ISO 639-1),
#   page (default 1)
# Response: { results, page, total_pages, total_results }
GET /api/search/series?query={{query}}&year=2024&language=ja&page=1

### List genres
# Public. Cached 24h server-side.
# Response: { "genres": [{ "tmdb_id": number, "name": string }] }
GET /api/genres

### Get library
# Requires cookie
# Query:
#   type=movie|series (required)
#   offset=0
#   limit=20 (max 50)
#   q (optional title/name)
#   filter_field + filter_operator + filter_value (all three together)
#   sort_field (default created_at)
#   sort_direction=0|1 (default 1 desc)
#   group_by=0|1|2 (watch_status, impression, status)
#   group_key (optional; only with group_by — page that group)
#
# filter_field: watch_status, impression, vote_average, release_year,
#   status, genre, original_language, origin_country
# filter_operator: 0 eq, 1 neq, 2 gt, 3 lt, 4 in
#   watch_status/impression: 0, 1, 4
#   impression value "none" matches null (No Impression)
#   vote_average/release_year: 0, 1, 2, 3
#   status/genre/original_language/origin_country: 0, 1, 4
# sort_field: created_at, release_date, title, vote_average,
#   last_watched_at, completed_at
# in values are comma-separated.
#
# Response: {
#   "movies": LibraryMovie[],
#   "series": LibrarySeries[],
#   "metadata": {
#     "count": { "movies": number, "series": number },
#     "offset": number,
#     "limit": number,
#     "hasMore": boolean,
#     "groups": [{ "key": string, "label": string, "count": number, "hasMore": boolean }]
#   }
# }
#
# Only the requested type's array is populated. metadata.count reflects the
# requested type only (movies or series); the other count is 0. Counts respect
# active browse filters when filter_field/operator/value or q are set; otherwise
# unfiltered totals for that type. metadata.groups is present only when group_by
# is set.
# Without group_key, items are the first limit rows per group.
# With group_key, items are that group's offset/limit page.
#
# LibraryMovie: tmdb_id, watch_status, impression, created_at, updated_at,
#   completed_at, title, poster_path, release_date, vote_average, status,
#   original_language, origin_country, certificate, genres
#
# LibrarySeries: tmdb_id, watch_status, impression, created_at, updated_at,
#   last_watched_at, completed_at, vote_average, name, first_air_date,
#   last_air_date, total_number_of_episodes, total_number_of_seasons,
#   total_number_of_seasons_watched, total_number_of_episodes_watched,
#   poster_path, status, original_language, origin_country, certificate,
#   genres, seasons_info
#
# seasons_info[]: season_number, episode_count, episodes_watched, air_date
# genres is a string array of genre names.
# vote_average is Rating on a 0–10 scale.
GET /api/library?type=movie

### Get library page (series)
GET /api/library?type=series&offset=20&limit=20

### Search library titles
GET /api/library?type=movie&q=batman

### Filter library
GET /api/library?type=movie&filter_field=watch_status&filter_operator=0&filter_value=2

### Sort and group library
GET /api/library?type=series&sort_field=vote_average&sort_direction=1&group_by=0

### Page one library group
GET /api/library?type=series&group_by=0&group_key=2&offset=20&limit=20

### Filter library by no impression
GET /api/library?type=movie&filter_field=impression&filter_operator=0&filter_value=none

### Get dashboard
# Requires cookie. Returns unfiltered library counts plus dashboard collections
# only (showInDashboard=true and groupBy=null), ordered by displayOrder ascending.
# Each collection includes a paginated preview (first page, limit 15) via the
# same query path as GET /api/collections/:id/items.
#
# Response: {
#   "counts": { "movies": number, "series": number },
#   "collections": DashboardCollection[]
# }
#
# DashboardCollection: CustomCollection plus
#   preview: {
#     "movies": LibraryMovie[],
#     "series": LibrarySeries[],
#     "metadata": LibraryMetadata
#   }
#
# Only the collection's mediaType array is populated in preview (movies or
# series). metadata.count reflects the collection filter; metadata.hasMore
# indicates more pages are available via GET /api/collections/:id/items.
# Collections with groupBy are excluded from the dashboard payload.
GET /api/dashboard

### Get movie details
# Optional cookie. `movieId` is the TMDB id.
# Logged-in users get is_present_in_watchlist, impression, watch_status.
GET /api/movie/{{movieId}}

### Add movie to library
# Requires cookie. No request body. The server fetches TMDB details (12h cache)
# and upserts catalog + user_movies.
# 201: same payload shape as GET movie details, with is_present_in_watchlist: true
# 409 if the movie is already in the library
POST /api/movie/{{movieId}}

### Update movie in library
# Requires cookie. Send at least one of watch_status or impression.
# watch_status: 0 Plan to Watch, 1 Watching, 2 Completed, 3 Dropped
# impression: 0 Dislike, 1 Like, 2 Love (or null)
# Response: { is_present_in_watchlist, watch_status, impression }
# 400 if the movie status does not allow watch activity updates.
PATCH /api/movie/{{movieId}}
Content-Type: application/json

{
  "watch_status": 1,
  "impression": 1
}

### Remove movie from library
# Requires cookie
DELETE /api/movie/{{movieId}}

### Get series details
# Optional cookie. `seriesId` is the TMDB id.
# Logged-in users get is_present_in_watchlist, impression, watch_status,
# episodes_watched on each season, total_number_of_episodes_watched,
# and total_number_of_seasons_watched.
GET /api/series/{{seriesId}}

### Add series to library
# Requires cookie. No request body. The server fetches TMDB details (12h cache)
# and upserts catalog, seasons, and user_series.
# 201: same payload shape as GET series details, with is_present_in_watchlist: true
# 409 if the series is already in the library
POST /api/series/{{seriesId}}

### Update series in library
# Requires cookie. Send at least one of watch_status, impression,
# or both mark_season_to_watched and mark_episode_to_watched together.
# Response: { is_present_in_watchlist, watch_status, impression,
#   total_number_of_episodes_watched, total_number_of_seasons_watched,
#   seasons: [{ season_number, episode_count, episodes_watched }] }
# 400 if the series status does not allow watch activity updates,
# or if the marked season has not aired yet.
PATCH /api/series/{{seriesId}}
Content-Type: application/json

{
  "watch_status": 1,
  "impression": 2,
  "mark_season_to_watched": 1,
  "mark_episode_to_watched": 3
}

### Remove series from library
# Requires cookie
DELETE /api/series/{{seriesId}}

### Update profile
# Requires cookie. Send at least one field.
# Username: 3-10 chars, letters/numbers/underscore
# newPassword uses the same rules as signup; currentPassword is required with it.
# Changing username refreshes the auth_token cookie.
# 409 if username or email is already in use.
PATCH /api/user/profile
Content-Type: application/json

{
  "username": "{{username}}",
  "email": "{{email}}",
  "displayName": "{{displayName}}",
  "currentPassword": "{{password}}",
  "newPassword": "{{password}}"
}

### List collections
# Requires cookie. Ordered by displayOrder ascending, then createdAt descending.
# Response: { "collections": CustomCollection[] }
#
# CustomCollection: id, userId, name, mediaType, showInDashboard,
#   showInLibrary, groupBy, displayOrder, createdAt, updatedAt,
#   filters[], sorts[]
#
# mediaType: 0 Movie, 1 Series
# groupBy: 0 Watch Status, 1 Impression, 2 Status (or null)
# filter operator: 0 eq, 1 neq, 2 gt, 3 lt, 4 in
# sort direction: 0 asc, 1 desc
#
# Validation rules (create and update when toggles/groupBy are sent):
#   - Exactly one filter is required on create; update may omit filters.
#   - At most one sort (optional).
#   - showInDashboard and groupBy cannot both be set.
#   - groupBy requires showInLibrary=true and showInDashboard=false.
GET /api/collections

### Create collection
# Requires cookie. Exactly one filter is required; at most one sort.
#
# filter.field: watch_status, impression, vote_average, release_year,
#   status, genre, original_language, origin_country
# filter.operator: same as library (see Get library)
# sort.field: created_at, release_date, title, vote_average,
#   last_watched_at, completed_at
#
# displayOrder defaults to 0; when 0, the server assigns the next order.
# Response 201: { "collection": CustomCollection }
POST /api/collections
Content-Type: application/json

{
  "name": "Action movies",
  "mediaType": 0,
  "showInDashboard": true,
  "showInLibrary": true,
  "groupBy": null,
  "displayOrder": 0,
  "filters": [
    {
      "field": "genre",
      "operator": 0,
      "value": "Action"
    }
  ],
  "sorts": [
    {
      "field": "vote_average",
      "direction": 1,
      "priority": 0
    }
  ]
}

### Create grouped library collection
# groupBy is for library-only grouped carousels (not dashboard).
POST /api/collections
Content-Type: application/json

{
  "name": "By watch status",
  "mediaType": 0,
  "showInDashboard": false,
  "showInLibrary": true,
  "groupBy": 0,
  "filters": [
    {
      "field": "genre",
      "operator": 0,
      "value": "Action"
    }
  ],
  "sorts": []
}

### Get collection
# Requires cookie. 404 if missing or not owned by the current user.
# Response: { "collection": CustomCollection }
GET /api/collections/{{collectionId}}

### Get collection items
# Requires cookie. Runs the collection's saved filter/sort/group against the
# library via listLibraryRows (same semantics as GET /api/library).
# 404 if missing or not owned by the current user.
#
# Query:
#   offset=0
#   limit=15 (max 50)
#   q (optional title/name search, combined server-side with collection filter)
#   group_key (optional; page one group when collection groupBy is set)
#
# Response: {
#   "collection": CustomCollection,
#   "movies": LibraryMovie[],
#   "series": LibrarySeries[],
#   "metadata": LibraryMetadata
# }
#
# Only the collection mediaType array is populated. metadata.groups is present
# when the collection has groupBy. Use group_key + offset/limit to page within
# a single group carousel.
GET /api/collections/{{collectionId}}/items?offset=0&limit=15

### Search within collection items
GET /api/collections/{{collectionId}}/items?q=wolverine&offset=0&limit=15

### Page one collection group
GET /api/collections/{{collectionId}}/items?group_key=2&offset=0&limit=15

### Update collection
# Requires cookie. All body fields are optional; if filters is sent it must
# contain exactly one item. Sending filters or sorts replaces the full list
# (existing ids are not reused). groupBy/showInDashboard/showInLibrary rules
# apply when any of those fields are sent.
# Response: { "collection": CustomCollection }
PUT /api/collections/{{collectionId}}
Content-Type: application/json

{
  "name": "Action movies",
  "showInLibrary": true,
  "filters": [
    {
      "field": "genre",
      "operator": 0,
      "value": "Action"
    }
  ],
  "sorts": [
    {
      "field": "title",
      "direction": 0,
      "priority": 0
    }
  ]
}

### Reorder collections
# Requires cookie. Body orderedIds must list every collection id for the user
# exactly once, in the desired displayOrder (0-based). 400 if ids are missing,
# unknown, or duplicated.
# Response: { "collections": CustomCollection[] }
PATCH /api/collections/reorder
Content-Type: application/json

{
  "orderedIds": [2, 1, 3]
}

### Delete collection
# Requires cookie. Deletes the collection and renormalizes displayOrder on
# remaining collections to 0…n-1. 404 if missing or not owned by the user.
# Response: { "collections": CustomCollection[] }
DELETE /api/collections/{{collectionId}}
